pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

// Material 3 colour scheme generated by matugen, from the wallpaper or a seed
// colour (see `appearance` in the config).
//
// The result is cached in ~/.local/state/kirin/scheme.json together with the
// inputs it was made from, so startup doesn't regenerate it. A copy for
// Hyprland goes to colors.lua next to it and is applied to borders and bars.
//
// Reading a big image is most of matugen's time (over a second for a 4K
// PNG), and the scheme only depends on the image through one source colour.
// So that colour is remembered per image (sources.json) and later schemes
// for it (mode, variant) are made from the colour, in milliseconds. The
// wallpaper picker has the colours worked out ahead with prepare().
Singleton {
    id: root

    readonly property string jsonPath: `${Wallpaper.stateDir}/scheme.json`
    readonly property string luaPath: `${Wallpaper.stateDir}/colors.lua`
    readonly property string sourcesPath: `${Wallpaper.stateDir}/sources.json`

    // Image path -> its source colour ("#rrggbb").
    property var sources: ({})

    readonly property var data: {
        try {
            return JSON.parse(cache.text());
        } catch (e) {
            return null;
        }
    }

    // Role name (matugen's snake_case, e.g. "surface_container") -> "#rrggbb".
    readonly property var colors: data?.colors ?? ({})
    readonly property bool generating: matugen.running

    readonly property var appearance: Config.appearance
    readonly property string inputs: JSON.stringify({
        source: appearance.source,
        // A video's first frame (appears once made).
        image: appearance.source === "wallpaper" ? Wallpaper.imageFor(Wallpaper.displayed) : "",
        color: appearance.source === "color" ? appearance.color : "",
        mode: appearance.mode,
        variant: appearance.variant
    })

    property bool cacheRead: false

    onInputsChanged: update()

    function update(): void {
        if (!cacheRead || !Config.loaded || data?.inputs === inputs)
            return;
        if (appearance.source === "wallpaper" && !Wallpaper.imageFor(Wallpaper.displayed))
            return;
        // Several settings often change at once; generate once for all of them.
        debounce.restart();
    }

    Timer {
        id: debounce

        interval: 50
        onTriggered: root.generate()
    }

    function generate(): void {
        const flags = ["--dry-run", "-q", "-j", "hex", "-m", appearance.mode, "-t", `scheme-${appearance.variant}`];
        const image = Wallpaper.imageFor(Wallpaper.displayed);
        const known = sources[image];
        const source = appearance.source === "color" ? ["color", "hex", appearance.color] : known ? ["color", "hex", known] : ["image", image, "--source-color-index", "0"];

        // Can't restart a running process; run again once it exits.
        if (matugen.running) {
            matugen.again = true;
            return;
        }
        matugen.forInputs = inputs;
        matugen.image = appearance.source === "wallpaper" && !known ? image : "";
        matugen.command = ["matugen", ...source, ...flags];
        matugen.running = true;
    }

    function remember(image: string, color: string): void {
        if (!image || !color || sources[image] === color)
            return;
        const next = Object.assign({}, sources);
        next[image] = color;
        sources = next;
        sourcesFile.setText(JSON.stringify(sources, null, 2) + "\n");
    }

    // Works out the source colours of these images in the background, one at
    // a time, so switching to any of them later is quick.
    function prepare(images: var): void {
        // Videos' frames are worked out when they're shown.
        const missing = images.filter(i => i && !Wallpaper.isVideo(i) && !sources[i] && !preparer.queue.includes(i) && preparer.current !== i);
        if (!missing.length)
            return;
        preparer.queue = preparer.queue.concat(missing);
        preparer.next();
    }

    function store(output: string, forInputs: string, image: string): void {
        // Empty when a run was replaced by a newer one.
        if (!output.trim())
            return;
        let parsed;
        try {
            parsed = JSON.parse(output);
        } catch (e) {
            console.warn("kirin: matugen returned no scheme");
            return;
        }

        remember(image, parsed.colors?.source_color?.default?.color ?? "");

        // With -m set, "default" holds the requested mode.
        const colors = {};
        for (const [name, value] of Object.entries(parsed.colors))
            colors[name] = value.default.color;

        cache.setText(JSON.stringify({ inputs: forInputs, colors }, null, 2) + "\n");

        const lua = Object.entries(colors).map(([name, hex]) => `  ${name} = "${hex.slice(1)}",`);
        hyprColors.setText(`-- Generated by kirin from scheme.json. Do not edit.\nreturn {\n${lua.join("\n")}\n}\n`);
    }

    // Pushes the current colors.lua into the running Hyprland.
    function applyToHyprland(): void {
        Quickshell.execDetached(["hyprctl", "eval", `kirin_apply_colors(dofile("${root.luaPath}"))`]);
    }

    Process {
        id: matugen

        property string forInputs
        // The image read, when made from one (not from a known colour).
        property string image
        property bool again: false

        onRunningChanged: {
            if (!running && again) {
                again = false;
                root.generate();
            }
        }

        stdout: StdioCollector {
            onStreamFinished: {
                // Outdated if settings changed while it ran.
                if (!matugen.again)
                    root.store(text, matugen.forInputs, matugen.image);
            }
        }
        stderr: StdioCollector {
            onStreamFinished: {
                if (text.trim())
                    console.warn(`kirin: matugen: ${text.trim()}`);
            }
        }
    }

    Process {
        id: preparer

        property var queue: []
        property string current

        function next(): void {
            if (running || !queue.length)
                return;
            current = queue[0];
            queue = queue.slice(1);
            command = ["matugen", "image", current, "--source-color-index", "0", "--dry-run", "-q", "-j", "hex", "-m", "dark"];
            running = true;
        }

        // The next one once this one's output is in (exit may come first).
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    root.remember(preparer.current, JSON.parse(text).colors.source_color.default.color);
                } catch (e) {}
                Qt.callLater(preparer.next);
            }
        }
    }

    FileView {
        id: sourcesFile

        path: root.sourcesPath
        printErrors: false
        onLoaded: {
            try {
                root.sources = Object.assign(JSON.parse(text()), root.sources);
            } catch (e) {}
        }
    }

    FileView {
        id: cache

        path: root.jsonPath
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: {
            root.cacheRead = true;
            root.update();
        }
        onLoadFailed: {
            root.cacheRead = true;
            root.update();
        }
    }

    FileView {
        id: hyprColors

        path: root.luaPath
        printErrors: false
        // A change Theme animates reaches Hyprland through it, step by step;
        // this file then lands when the shift ends.
        onSaved: {
            if (!Theme.shifting)
                root.applyToHyprland();
        }
    }

    Connections {
        target: Config

        function onLoadedChanged(): void {
            root.update();
        }
    }
}
